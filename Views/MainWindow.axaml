<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IotExpertApp.ViewModels"
        x:Class="IotExpertApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1100" Height="800" MinWidth="760" MinHeight="500"
        Icon="/Assets/avalonia-logo.ico" Title="IotExpertApp — монитор стенда">
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
         design-time DataContext здесь больше не задаем: MainViewModel получает приемник из App -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16" RowSpacing="12">
        <StackPanel Spacing="8">
            <TextBlock Text="Стенд ESP32 · первый этап v0.1.0" FontSize="23"/>
            <WrapPanel>
                <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" MinWidth="240" Margin="0,0,8,8"/>
                <Button Content="Обновить порты" Command="{Binding RefreshPortsCommand}" Margin="0,0,8,8"/>
                <Button Content="Подключиться" Command="{Binding ConnectCommand}" Margin="0,0,8,8"/>
                <Button Content="Остановить" Command="{Binding StopCommand}" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBox Text="{Binding CapturePath}" PlaceholderText="Новый файл записи при подключении (пусто — без записи), лимит 10 МиБ"/>
            <WrapPanel>
                <Button Content="Завершить запись" Command="{Binding StopCaptureCommand}" Margin="0,0,8,8"/>
                <CheckBox Content="Воспроизводить по времени" IsChecked="{Binding TimedReplay}" Margin="0,0,8,8"/>
                <Button Content="{Binding PauseText}" Command="{Binding TogglePauseCommand}" Margin="0,0,8,8"/>
            </WrapPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding ReplayPath}" PlaceholderText="Абсолютный путь к UART-записи"/>
                <Button Grid.Column="1" Content="Прочитать файл" Command="{Binding ReadFileCommand}"/>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Identity}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LocalDiagnostic}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Statistics}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Playback}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Capture}" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Observations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ObservationRow">
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="17"/>
                                <TextBlock Text="{Binding State}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Values}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="90"/>
    </Grid>
</Window>
